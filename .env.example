# SecuriX Environment Variables — Template
# Copy this file to .env and fill in real values
# Never commit .env to git

# PostgreSQL (Apache AGE)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/securix_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=venkat@2007VK
POSTGRES_DB=securix_db

# Kafka (leave blank to run without Kafka)
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC=findings.raw

# AI / LLM Keys & Ollama Integration
# For localhost: http://localhost:11434
# For remote laptop: http://<other-laptop-ip>:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
OPENAI_API_KEY=sk-mock
ANTHROPIC_API_KEY=sk-mock
GEMINI_API_KEY=sk-mock

# Keycloak SSO (leave blank to use dev mock)
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin123

# Auth (Postgres-backed login, FastAPI)
# Used by auth-service (port 8019) and the portal server fallback
JWT_SECRET=securix-dev-secret-change-me
AUTH_SERVICE_URL=http://localhost:8019
